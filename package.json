{
  "name": "oai-codex-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable Codex gateway, API reference and testing dashboard",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sofianbll/oai-codex-server.git"
  },
  "packageManager": "bun@1.3.13",
  "bin": {
    "oai-codex": "./bin/oai-codex"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "bun test ./tests",
    "serve": "bun run src/cli/main.ts serve",
    "dev": "bun --watch src/cli/main.ts serve",
    "lint": "biome check src tests scripts api-tests",
    "test:live": "bun scripts/live-smoke.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "hono": "^4.13.12",
    "ky": "^2.1.0",
    "openai": "7.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@scalar/api-reference": "^1.72.4",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
